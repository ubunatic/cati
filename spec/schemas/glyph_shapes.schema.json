{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cati glyph shapes spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "vector_shapes"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "vector_shapes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "glyphs"],
      "properties": {
        "points": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/cellPoint" }
        },
        "glyphs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["glyph"],
            "properties": {
              "glyph": { "type": "string", "minLength": 1 },
              "rects": {
                "type": "array",
                "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/cellFrac" } }
              },
              "polys": {
                "type": "array",
                "items": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
              },
              "split": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
              "invert": { "type": "string", "minLength": 1 },
              "masks": {
                "type": "object",
                "propertyNames": { "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[#.]+$" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cellFrac": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "string", "pattern": "^[0-9]+/[1-9][0-9]*$" }
      ]
    },
    "cellPoint": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/cellFrac" } }
  }
}
