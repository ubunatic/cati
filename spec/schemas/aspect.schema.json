{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cati aspect snapping policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["pixel", "formula"],
  "properties": {
    "$schema": { "type": "string" },
    "pixel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_distortion", "max_padding"],
      "properties": {
        "max_distortion": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_padding": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "halfblock", "quad"],
      "properties": {
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["num", "den"],
          "properties": {
            "num": { "type": "integer", "minimum": 1 },
            "den": { "type": "integer", "minimum": 1 }
          }
        },
        "halfblock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["num", "den"],
          "properties": {
            "num": { "type": "integer", "minimum": 1 },
            "den": { "type": "integer", "minimum": 1 }
          }
        },
        "quad": {
          "type": "object",
          "additionalProperties": false,
          "required": ["num", "den"],
          "properties": {
            "num": { "type": "integer", "minimum": 1 },
            "den": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}

