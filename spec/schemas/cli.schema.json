{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cli.schema.json",
  "title": "Cati CLI flags",
  "type": "object",
  "required": ["flags"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["long", "description", "handler"],
        "properties": {
          "long": { "type": "string", "pattern": "^--[a-z][a-z-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "handler": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "description": "Flag defaults keyed by command path, then long flag name (without --).",
      "propertyNames": { "pattern": "^cati[a-z]*( [a-z][a-z-]*)*$" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
        "additionalProperties": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "default": { "type": "string", "description": "value applied via pflag Set and shown in --help" },
            "no_opt": { "type": "string", "description": "value used when the flag is given without an argument" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
