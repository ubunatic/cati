{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cati render modes spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycle", "modes", "glyph_sets", "colorers", "renderers", "smart", "set_registry", "composition_order", "composition_info", "compositions", "vector_shapes"],
  "properties": {
    "cycle": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "aliases", "renderer", "cell", "glyph_sets", "colorer", "smart_step", "native_step"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string", "minLength": 1 },
          "renderer": { "type": "string", "minLength": 1 },
          "cell": { "$ref": "#/$defs/geometry" },
          "analysis": { "$ref": "#/$defs/geometry" },
          "glyph_sets": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "colorer": { "type": "string", "minLength": 1 },
          "smart_step": { "enum": ["terminal-column", "native"] },
          "native_step": { "type": "integer", "minimum": 1 },
          "optimized": { "type": "boolean" }
        }
      }
    },
    "glyph_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "colorers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "renderers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "smart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "max_reduction", "step", "tie_break"],
      "properties": {
        "metric": { "const": "psnr" },
        "max_reduction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "step": { "enum": ["terminal-column", "native"] },
        "tie_break": { "const": "widest" }
      }
    },
    "set_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "geometry"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "geometry": { "$ref": "#/$defs/geometry" },
          "glyphs": { "type": "array", "items": { "type": "string" } },
          "masks": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[01]+$" }
          },
          "generated": { "enum": ["sextant_2x3", "unicode_bars", "braille_2x4", "octant_2x4", "vector_linear_splits"] },
          "approximate": { "type": "boolean" },
          "optimized": { "type": "boolean" }
        }
      }
    },
    "composition_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "experimental": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "composition_info": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "compositions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "vector_shapes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "glyphs"],
      "properties": {
        "points": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/cellPoint" }
        },
        "glyphs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["glyph"],
            "properties": {
              "glyph": { "type": "string", "minLength": 1 },
              "rects": {
                "type": "array",
                "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/cellFrac" } }
              },
              "polys": {
                "type": "array",
                "items": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
              },
              "split": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
              "invert": { "type": "string", "minLength": 1 },
              "masks": {
                "type": "object",
                "propertyNames": { "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[#.]+$" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cellFrac": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "string", "pattern": "^[0-9]+/[1-9][0-9]*$" }
      ]
    },
    "cellPoint": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/cellFrac" } },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
